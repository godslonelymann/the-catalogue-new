# The Catalogue: runtime settings for the API (api/) and the worker (worker/).
# Copy this file to .env and fill in the values. Never commit .env.
# Production values live on the EC2 host, not in git.

# --- App -------------------------------------------------------------------
# Public origin of the frontend. Email links and the Google callback use it.
APP_BASE_URL=http://localhost:5173
# "development" or "production". Production requires HTTPS and Secure cookies.
APP_ENV=development
# Set to true in production (HTTPS). Local http://localhost needs false.
COOKIE_SECURE=false

# --- Database (PostgreSQL 18) -----------------------------------------------
# Separate roles for the API and the worker. Use the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://catalogue_api:CHANGE_ME@127.0.0.1:5432/catalogue
WORKER_DATABASE_URL=postgresql+psycopg://catalogue_worker:CHANGE_ME@127.0.0.1:5432/catalogue
# Owner role for Alembic migrations (release step only).
MIGRATION_DATABASE_URL=postgresql+psycopg://catalogue_owner:CHANGE_ME@127.0.0.1:5432/catalogue

# --- Sessions and two-factor ------------------------------------------------
# Signs the access tokens (PyJWT, HS256). At least 32 random bytes.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
# Fernet key that encrypts authenticator secrets.
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=

# --- Google sign-in (OpenID Connect) ----------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI under "Authorized redirect URIs" for the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# --- Email (Gmail SMTP) -----------------------------------------------------
# Emails go from your Gmail account to each user's own address.
# Gmail allows about 500 emails a day from a personal account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Your full Gmail address.
SMTP_USERNAME=
# A Google app password (16 letters), NOT your normal Gmail password.
# Create it: Google Account > Security > 2-Step Verification (turn on) > App passwords.
SMTP_PASSWORD=
# Must be the same Gmail address as SMTP_USERNAME, for example: The Catalogue <you@gmail.com>
EMAIL_FROM=
# Optional reply-to address.
EMAIL_REPLY_TO=
