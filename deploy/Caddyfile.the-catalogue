thecatalogue.duckdns.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # The API. Vercel forwards /api/* here, so the browser only sees the Vercel address.
    handle /api/* {
        request_body {
            max_size 64KB
        }
        reverse_proxy 127.0.0.1:8000
    }

    # The app lives on Vercel.
    handle {
        redir https://the-catalogue-kappa.vercel.app{uri} permanent
    }

    log {
        output file /var/log/caddy/thecatalogue-access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}

# Old address: send visitors to the app.
the-catalogue.duckdns.org {
    redir https://the-catalogue-kappa.vercel.app{uri} permanent
}

