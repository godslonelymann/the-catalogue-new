[Unit]
Description=The Catalogue: retry restock emails that are due
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/the-catalogue-new/backend
ExecStart=/home/ubuntu/the-catalogue-new/backend/.venv/bin/python -m app.jobs.send_alerts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
